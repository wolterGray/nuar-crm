NODE_ENV=production
PORT=3001
# Log successful backend requests only when they take at least this long.
SLOW_REQUEST_MS=2000
DATABASE_URL=postgresql://nuar_crm:change-me@127.0.0.1:5432/nuar_crm?schema=public

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-long-password
JWT_SECRET=change-me-at-least-32-random-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=90d

# Comma-separated frontend origins allowed to call the backend.
CORS_ORIGIN=https://crm.example.com

# Optional automation / messaging integrations. Leave empty if unused.
SMSAPI_TOKEN=
SMSAPI_SENDER=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
NOTIFICATION_WORKER_BATCH_SIZE=50
NOTIFICATION_LIFECYCLE_V2_WRITE=false

# Automatic cleanup applies only to technical logs and completed delivery/job records.
DATA_RETENTION_ENABLED=true
DATA_INTEGRITY_CHECK_ENABLED=true
RETENTION_AUDIT_LOG_DAYS=730
RETENTION_AUTH_SESSION_DAYS=30
RETENTION_ERROR_EVENT_DAYS=90
RETENTION_NOTIFICATION_DAYS=180
RETENTION_INTEGRATION_JOB_DAYS=90
RETENTION_RESET_TOKEN_DAYS=30

# Generate once and keep the private key only in the protected backend environment.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nuarr.pl

# Database backup/export helper.
BACKUP_DIR=backups
BACKUP_STALE_AFTER_HOURS=30
# Production /ready fails when the latest local or configured mirrored backup is unhealthy.
BACKUP_READINESS_REQUIRED=true
# Full restore drills older than this remain visible as stale in system diagnostics.
RESTORE_DRILL_STALE_AFTER_DAYS=35
# Optional mounted/off-host directory. When set, deploy stops unless the mirrored copy passes size and SHA-256 verification.
# BACKUP_MIRROR_DIR=/mnt/nuar-backups
# Optional: set full path if pg_dump is not available in PATH.
# PGDUMP_PATH=/usr/bin/pg_dump
