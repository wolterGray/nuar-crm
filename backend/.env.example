DATABASE_URL=postgresql://postgres:password@localhost:5432/nuar_crm?schema=public
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-password
JWT_SECRET=your-long-secret
PORT=3001
CORS_ORIGIN=http://localhost:5173,http://192.168.18.20:5173,https://crm.nuarr.pl
BACKUP_DIR=backups
# Web Push (generate once with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@nuarr.pl
# Historical lifecycle writes stay disabled until a reviewed dry-run is approved.
NOTIFICATION_LIFECYCLE_V2_WRITE=false
# Optional: set full path if pg_dump is not available in PATH.
# PGDUMP_PATH=/usr/local/bin/pg_dump
